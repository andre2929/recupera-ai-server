# === RECUPERA.AI — configuracao ===
# Copie para ".env" e preencha. NUNCA versione o .env real.

# --- IA (opcional, escolhe pela chave presente) ---
# Sem chave, o bot roda 100% no motor deterministico (roteiro fixo). Com chave,
# a IA reescreve/conversa no tom humano. A DECISAO (gerar Pix, valor, etc.)
# e SEMPRE do codigo — a IA so escreve o texto.
#
# RECOMENDADO: Groq (GRATIS, rapido, sem cartao). Crie a chave em:
#   https://console.groq.com/keys  -> cole abaixo. Pronto.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Alternativa: Google Gemini (free tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#
# Alternativa paga: Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Pagamento (Asaas) ---
# MODO=mock gera Pix estatico com a CHAVE abaixo (pagavel, mas confirmacao manual).
# MODO=sandbox/producao usa o Asaas (confirmacao automatica por webhook).
PAGAMENTO_MODO=mock
# Chave Pix de recebimento (CNPJ so digitos). Padrao = CNPJ da CDL.
PIX_CHAVE=03962883000109
PIX_NOME=CDL CAMPO GRANDE
PIX_CIDADE=CAMPO GRANDE
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Voz (edge-tts, gratis) ---
# A abertura vai como nota de voz no WhatsApp. VOZ_ATIVA=0 desliga (so texto).
# Requer python + "pip install edge-tts". Voz: Francisca (padrao) ou pt-BR-ThalitaMultilingualNeural.
VOZ_ATIVA=1
VOZ_MARINA=pt-BR-FranciscaNeural

# --- WhatsApp ---
# transporte: "wwebjs" (local, QR no terminal) ou "evolution" (producao, VPS).
WA_TRANSPORTE=wwebjs
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- Servidor / webhook de pagamento ---
PORTA=8787
